# COS360 Mobile App — Environment Variables
# Copy this file to .env and fill in your values
# EXPO_PUBLIC_* variables are exposed to the app bundle (safe for API URLs)
# Never put secrets/passwords here

# API Server URL (replace with your server's IP or domain)
EXPO_PUBLIC_API_URL=http://192.168.0.110:8000/api/v1

# App environment: development | staging | production
APP_ENV=development
