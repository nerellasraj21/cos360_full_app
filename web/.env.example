# COS360 Frontend Environment Configuration

# API Configuration
VITE_API_BASE_URL=http://localhost:8003/api/v1
VITE_API_TIMEOUT=30000

# Authentication
VITE_JWT_REFRESH_THRESHOLD=300000
VITE_SESSION_TIMEOUT=3600000

# Multi-tenant Configuration
VITE_DEFAULT_TENANT=test_tenant
VITE_TENANT_HEADER=cschema

# File Upload Configuration
VITE_MAX_FILE_SIZE=5242880
VITE_SUPPORTED_FILE_TYPES=pdf,jpg,jpeg,png

# Caching Configuration
VITE_CACHE_TTL=300000
VITE_CACHE_MAX_SIZE=50

# Rate Limiting
VITE_API_RATE_LIMIT=100
VITE_API_RATE_WINDOW=60000

# Development
VITE_DEV_MODE=true
VITE_LOG_LEVEL=debug