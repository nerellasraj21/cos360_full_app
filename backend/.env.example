# COS360 Environment Variables Template
# Copy this file to .env and update the values for your environment

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# The API connects as the app role: not the table owner, not a superuser, no BYPASSRLS
DATABASE_URL=postgresql+asyncpg://cos360_app:your_app_password@localhost:5432/cos360_unischema
# Alembic connects as the owner role (never used by the API)
MIGRATION_DATABASE_URL=postgresql+psycopg2://cos360_owner:your_owner_password@localhost:5432/cos360_unischema

# For production (replace with your actual database server)
# DATABASE_URL=postgresql+asyncpg://username:password@your-db-server:5432/dbname

# =============================================================================
# REDIS CONFIGURATION  
# =============================================================================
# For development (localhost)
REDIS_URL=redis://localhost:6379

# For production (replace with your actual Redis server)
# REDIS_URL=redis://your-redis-server:6379

# =============================================================================
# SECURITY KEYS (REQUIRED - GENERATE SECURE VALUES)
# =============================================================================
SECRET_KEY=your-super-secure-secret-key-here-min-32-chars
JWT_SECRET_KEY=your-jwt-secret-key-here-min-32-chars
# Initial password for POST /super_admin/setup/initialize (only works while no super admin exists)
# SUPER_ADMIN_INITIAL_PASSWORD=

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
# Environment type
DEBUG=false
ENVIRONMENT=development

# JWT Token Settings
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Pagination
PAGE_SIZE=20

# Logging
LOG_LEVEL=INFO

# =============================================================================
# COMMUNICATION MODULE — PROVIDER CREDENTIALS
# =============================================================================
# MSG91 SMS (Flow API — DLT compliant)
MSG91_AUTH_KEY=
MSG91_SENDER_ID=RASVEK
MSG91_ROUTE=transactional
MSG91_TEMPLATE_ID_ADMISSION=
MSG91_TEMPLATE_ID_FEE_RECEIPT=
MSG91_TEMPLATE_ID_EXAM_SCHEDULE=
MSG91_TEMPLATE_ID_HALL_TICKET=
MSG91_TEMPLATE_ID_RESULTS=
MSG91_TEMPLATE_ID_ABSENTEE=
MSG91_TEMPLATE_ID_STAFF_INTERVIEW=
MSG91_TEMPLATE_ID_STAFF_ATTENDANCE=
MSG91_TEMPLATE_ID_HOLIDAY=
MSG91_TEMPLATE_ID_HOMEWORK=

# WhatsApp Business Cloud API (Meta)
WA_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WA_ACCESS_TOKEN=your-whatsapp-cloud-api-access-token

# SendGrid Email API
SENDGRID_API_KEY=SG.your-sendgrid-api-key-here
EMAIL_FROM=noreply@yourschool.com
EMAIL_FROM_NAME=COS360 School Management

# =============================================================================
# PRODUCTION DEPLOYMENT NOTES
# =============================================================================
# 1. Replace DATABASE_URL with your production database server
# 2. Replace REDIS_URL with your production Redis server  
# 3. Generate secure random values for SECRET_KEY and JWT_SECRET_KEY
# 4. Set DEBUG=false for production
# 5. Set ENVIRONMENT=production
# 6. Configure CORS origins if needed
# 7. Ensure your hosting platform supports these environment variables