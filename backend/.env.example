# COS360 Environment Variables Template
# Copy this file to .env and update the values for your environment

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# For development (localhost)
DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/postgres

# For production (replace with your actual database server)
# DATABASE_URL=postgresql+asyncpg://username:password@your-db-server:5432/dbname

# =============================================================================
# REDIS CONFIGURATION  
# =============================================================================
# For development (localhost)
REDIS_URL=redis://localhost:6379

# For production (replace with your actual Redis server)
# REDIS_URL=redis://your-redis-server:6379

# =============================================================================
# SECURITY KEYS (REQUIRED - GENERATE SECURE VALUES)
# =============================================================================
SECRET_KEY=your-super-secure-secret-key-here-min-32-chars
JWT_SECRET_KEY=your-jwt-secret-key-here-min-32-chars

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
# Environment type
DEBUG=false
ENVIRONMENT=development

# JWT Token Settings
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Pagination
PAGE_SIZE=20

# Logging
LOG_LEVEL=INFO

# =============================================================================
# DATABASE MIGRATION SETTINGS
# =============================================================================
# Schema name for tenant isolation
SCHEMA_NAME=cos360_masters

# =============================================================================
# PRODUCTION DEPLOYMENT NOTES
# =============================================================================
# 1. Replace DATABASE_URL with your production database server
# 2. Replace REDIS_URL with your production Redis server  
# 3. Generate secure random values for SECRET_KEY and JWT_SECRET_KEY
# 4. Set DEBUG=false for production
# 5. Set ENVIRONMENT=production
# 6. Configure CORS origins if needed
# 7. Ensure your hosting platform supports these environment variables