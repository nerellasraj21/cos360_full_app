			},
			"response": []
		},
		{
			"name": "7. DELETE Academic Year (Soft Delete/Deactivate)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 200', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('Record is deactivated', function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.is_active).to.be.false;",
							"    pm.expect(jsonData.id).to.exist;",
							"});",
							"",
							"pm.test('Record still exists in database', function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.title).to.exist;",
							"    pm.expect(jsonData.created_at).to.exist;",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
