							"    if (jsonData.length > 0) {",
							"        pm.expect(jsonData[0].id).to.exist;",
							"        pm.expect(jsonData[0].title).to.exist;",
							"        // Should only have id and title for dropdown",
							"        var keys = Object.keys(jsonData[0]);",
							"        pm.expect(keys).to.have.lengthOf.at.most(3); // id, title, maybe is_active",
							"    }",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "cschema",
						"value": "{{tenant_schema}}"
					}
				],
				"url": {
					"raw": "{{base_url}}/api/v1/masters/academic_years/dropdown?active_only=true",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"v1",
						"masters",
						"academic_years",
						"dropdown"
					],
					"query": [
						{
							"key": "active_only",
							"value": "true",
							"description": "Filter for active years only"
						}
					]
				},
				"description": "Get academic years dropdown data (id + title only)\n\nOptimized for UI dropdown components - returns minimal data.\n\nParameters:\n- active_only: Filter for active years (default: true)\n\nRate Limited: 100 requests per minute\nPermissions: Available to all roles"
			},
			"response": []
		},
