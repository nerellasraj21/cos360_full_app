{
	"info": {
		"_postman_id": "route-crud-collection",
		"name": "Level 0 - Route CRUD (Enhanced - Fixed Endpoints)",
		"description": "Complete CRUD operations for Route model (Level 0 - No Dependencies)\n\n🔧 **Configuration:**\n- Base URL: http://127.0.0.1:8003\n- Authentication: Admin JWT Token (auto-fetched)\n- Tenant: test_tenant\n- Path: /api/v1/masters/routes/\n\n📋 **7 Endpoints Covered:**\n1. CREATE Route (POST /)\n2. LIST All Routes (GET /all_routes)\n3. GET Route by ID (GET /routeid/{route_id})\n4. GET Routes Dropdown (GET /dropdown)\n5. UPDATE Route (PUT /{route_id})\n6. DELETE Route (DELETE /{route_id})\n7. GET Stops by Route Name (GET /stops-by-route?route_name=)\n\n⚠️ **Rate Limits:**\n- CREATE: 30 per minute\n- Dropdown: 100 per minute\n\n🎯 **Features:**\n- Auto token refresh\n- Variable chaining\n- UUID validation\n- Comprehensive testing",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [{"key": "token", "value": "{{admin_token}}", "type": "string"}]
	},
	"event": [{
		"listen": "prerequest",
		"script": {
			"type": "text/javascript",
			"exec": [
				"if (!pm.globals.get('admin_token')) {",
				"    pm.sendRequest({",
				"        url: 'http://127.0.0.1:8003/api/v1/auth/test-jwt/admin-token',",
				"        method: 'GET'",
				"    }, function (err, response) {",
				"        if (!err) {",
				"            pm.globals.set('admin_token', response.json().access_token);",
				"            console.log('Admin token refreshed');",
				"        }",
				"    });",
				"}"
			]
		}
	}],
	"variable": [
		{"key": "base_url", "value": "http://127.0.0.1:8003", "type": "string"},
		{"key": "tenant_schema", "value": "test_tenant", "type": "string"}
	],
	"item": [
		{
			"name": "0. Get Admin Token",
			"event": [{
				"listen": "test",
				"script": {
					"exec": [
						"pm.test('Status code is 200', function () {",
						"    pm.response.to.have.status(200);",
						"});",
						"pm.test('Token received', function () {",
						"    var jsonData = pm.response.json();",
						"    pm.expect(jsonData.access_token).to.exist;",
						"    pm.globals.set('admin_token', jsonData.access_token);",
						"});"
					]
				}
			}],
			"request": {
				"method": "GET",
				"header": [],
				"url": "{{base_url}}/api/v1/auth/test-jwt/admin-token"
			}
		},
		{
			"name": "1. CREATE Route",
			"event": [{
				"listen": "test",
				"script": {
					"exec": [
						"pm.test('Status code is 200', function () {",
						"    pm.response.to.have.status(200);",
						"});",
						"pm.test('Route created with UUID', function () {",
						"    var jsonData = pm.response.json();",
						"    pm.expect(jsonData.id).to.exist;",
						"    pm.expect(jsonData.route_name).to.exist;",
						"    pm.globals.set('route_id', jsonData.id);",
						"    var uuidRegex = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;",
						"    pm.expect(jsonData.id).to.match(uuidRegex);",
						"});"
					]
				}
			}],
			"request": {
				"method": "POST",
				"header": [
					{"key": "Content-Type", "value": "application/json"},
					{"key": "cschema", "value": "{{tenant_schema}}"}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"route_name\": \"Test Route 001\",\n    \"description\": \"Test route for Postman collection\",\n    \"is_active\": true\n}"
				},
				"url": "{{base_url}}/api/v1/masters/routes/"
			}
		},
		{
			"name": "2. LIST All Routes",
			"event": [{
				"listen": "test",
				"script": {
					"exec": [
						"pm.test('Status code is 200', function () {",
						"    pm.response.to.have.status(200);",
						"});",
						"pm.test('Response is array', function () {",
						"    var jsonData = pm.response.json();",
						"    pm.expect(jsonData).to.be.an('array');",
						"});"
					]
				}
			}],
			"request": {
				"method": "GET",
				"header": [{"key": "cschema", "value": "{{tenant_schema}}"}],
				"url": "{{base_url}}/api/v1/masters/routes/all_routes"
			}
		},
		{
			"name": "3. GET Route by ID",
			"event": [{
				"listen": "test",
				"script": {
					"exec": [
						"pm.test('Status code is 200', function () {",
						"    pm.response.to.have.status(200);",
						"});",
						"pm.test('Route details returned', function () {",
						"    var jsonData = pm.response.json();",
						"    pm.expect(jsonData.id).to.exist;",
						"    pm.expect(jsonData.route_name).to.exist;",
						"});"
					]
				}
			}],
			"request": {
				"method": "GET",
				"header": [{"key": "cschema", "value": "{{tenant_schema}}"}],
				"url": "{{base_url}}/api/v1/masters/routes/routeid/{{route_id}}"
			}
		},
		{
			"name": "4. GET Routes Dropdown",
			"event": [{
				"listen": "test",
				"script": {
					"exec": [
						"pm.test('Status code is 200', function () {",
						"    pm.response.to.have.status(200);",
						"});",
						"pm.test('Dropdown format correct', function () {",
						"    var jsonData = pm.response.json();",
						"    pm.expect(jsonData).to.be.an('array');",
						"    if (jsonData.length > 0) {",
						"        pm.expect(jsonData[0].id).to.exist;",
						"        pm.expect(jsonData[0].route_name).to.exist;",
						"    }",
						"});"
					]
				}
			}],
			"request": {
				"method": "GET",
				"header": [{"key": "cschema", "value": "{{tenant_schema}}"}],
				"url": "{{base_url}}/api/v1/masters/routes/dropdown?active_only=true"
			}
		},
		{
			"name": "5. UPDATE Route",
			"event": [{
				"listen": "test",
				"script": {
					"exec": [
						"pm.test('Status code is 200', function () {",
						"    pm.response.to.have.status(200);",
						"});",
						"pm.test('Route updated', function () {",
						"    var jsonData = pm.response.json();",
						"    pm.expect(jsonData.route_name).to.include('Updated');",
						"});"
					]
				}
			}],
			"request": {
				"method": "PUT",
				"header": [
					{"key": "Content-Type", "value": "application/json"},
					{"key": "cschema", "value": "{{tenant_schema}}"}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"route_name\": \"Updated Test Route 001\",\n    \"description\": \"Updated test route description\",\n    \"is_active\": true\n}"
				},
				"url": "{{base_url}}/api/v1/masters/routes/{{route_id}}"
			}
		},
		{
			"name": "6. GET Stops by Route Name",
			"event": [{
				"listen": "test",
				"script": {
					"exec": [
						"pm.test('Status code is 200', function () {",
						"    pm.response.to.have.status(200);",
						"});",
						"pm.test('Response is array', function () {",
						"    var jsonData = pm.response.json();",
						"    pm.expect(jsonData).to.be.an('array');",
						"});"
					]
				}
			}],
			"request": {
				"method": "GET",
				"header": [{"key": "cschema", "value": "{{tenant_schema}}"}],
				"url": {
					"raw": "{{base_url}}/api/v1/masters/routes/stops-by-route?route_name=Updated Test Route 001",
					"host": ["{{base_url}}"],
					"path": ["api", "v1", "masters", "routes", "stops-by-route"],
					"query": [{"key": "route_name", "value": "Updated Test Route 001"}]
				}
			}
		},
		{
			"name": "7. DELETE Route",
			"event": [{
				"listen": "test",
				"script": {
					"exec": [
						"pm.test('Status code is 200', function () {",
						"    pm.response.to.have.status(200);",
						"});"
					]
				}
			}],
			"request": {
				"method": "DELETE",
				"header": [{"key": "cschema", "value": "{{tenant_schema}}"}],
				"url": "{{base_url}}/api/v1/masters/routes/{{route_id}}"
			}
		}
	]
}