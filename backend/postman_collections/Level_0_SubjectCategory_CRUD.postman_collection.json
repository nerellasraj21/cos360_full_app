{
	"info": {
		"_postman_id": "subject-category-crud-collection",
		"name": "Level 0 - Subject Category CRUD (Enhanced)",
		"description": "Complete CRUD operations for Subject Category model (Level 0 - No Dependencies)\n\n🔧 **Configuration:**\n- Base URL: http://127.0.0.1:8003\n- Authentication: Admin JWT Token (auto-fetched)\n- Tenant: test_tenant\n- Path: /api/v1/masters/subject_categories/categories\n\n📋 **3 Endpoints Covered:**\n1. CREATE Subject Category (POST /categories)\n2. LIST Subject Categories (GET /categories)\n3. GET Subject Categories Dropdown (GET /categories/dropdown)\n\n🎯 **Features:**\n- Auto token refresh\n- Variable chaining\n- Response validation\n- Rate limit handling (30/min create, 100/min dropdown)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{admin_token}}",
				"type": "string"
			}
		]
	},
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"if (!pm.globals.get('admin_token')) {",
					"    pm.sendRequest({",
					"        url: 'http://127.0.0.1:8003/api/v1/auth/test-jwt/admin-token',",
					"        method: 'GET'",
					"    }, function (err, response) {",
					"        if (!err) {",
					"            pm.globals.set('admin_token', response.json().access_token);",
					"        }",
					"    });",
					"}"
				]
			}
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://127.0.0.1:8003"
		},
		{
			"key": "tenant_schema",
			"value": "test_tenant"
		}
	],
	"item": [
		{
			"name": "1. CREATE Subject Category",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 200', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"var jsonData = pm.response.json();",
							"pm.globals.set('subject_category_id', jsonData.id);"
						]
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "cschema",
						"value": "{{tenant_schema}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"name\": \"Test Science Category\",\n    \"description\": \"Science related subjects\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/v1/masters/subject_categories/categories",
					"host": ["{{base_url}}"],
					"path": ["api", "v1", "masters", "subject_categories", "categories"]
				}
			}
		},
		{
			"name": "2. LIST Subject Categories",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 200', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test('Response is array', function () {",
							"    pm.expect(pm.response.json()).to.be.an('array');",
							"});"
						]
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "cschema",
						"value": "{{tenant_schema}}"
					}
				],
				"url": {
					"raw": "{{base_url}}/api/v1/masters/subject_categories/categories",
					"host": ["{{base_url}}"],
					"path": ["api", "v1", "masters", "subject_categories", "categories"]
				}
			}
		},
		{
			"name": "3. GET Subject Categories Dropdown",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "cschema",
						"value": "{{tenant_schema}}"
					}
				],
				"url": {
					"raw": "{{base_url}}/api/v1/masters/subject_categories/categories/dropdown",
					"host": ["{{base_url}}"],
					"path": ["api", "v1", "masters", "subject_categories", "categories", "dropdown"]
				}
			}
		}
	]
}