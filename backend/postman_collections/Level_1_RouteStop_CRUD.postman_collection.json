{
	"info": {
		"_postman_id": "route-stop-crud-collection-uuid",
		"name": "Level 1: RouteStop CRUD Operations",
		"description": "Comprehensive CRUD operations for RouteStop model with dependency on Route.\n\nDependencies:\n- Route (route_id) - Level 0\n\nEndpoints tested:\n1. POST /masters/route-stops - Create RouteStop\n2. GET /masters/route-stops - List All RouteStops\n3. GET /masters/route-stops/{id} - Get RouteStop by ID\n4. PUT /masters/route-stops/{id} - Update RouteStop (Full)\n5. PATCH /masters/route-stops/{id} - Update RouteStop (Partial)\n6. DELETE /masters/route-stops/{id} - Delete/Deactivate RouteStop",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{adminToken}}",
				"type": "string"
			}
		]
	},
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"exec": [
					"// Auto-refresh admin token if needed",
					"if (!pm.globals.get('adminToken') || !pm.globals.get('tokenExpiry') || ",
					"    Date.now() > parseInt(pm.globals.get('tokenExpiry'))) {",
					"    ",
					"    const loginRequest = {",
					"        url: pm.environment.get('baseUrl') + '/auth/tenant-login',",
					"        method: 'POST',",
					"        header: {",
					"            'Content-Type': 'application/json',",
					"            'X-Client-Name': pm.environment.get('tenantName')",
					"        },",
					"        body: {",
					"            mode: 'raw',",
					"            raw: JSON.stringify({",
					"                username: pm.environment.get('adminUsername'),",
					"                password: pm.environment.get('adminPassword')",
					"            })",
					"        }",
					"    };",
					"    ",
					"    pm.sendRequest(loginRequest, function(err, response) {",
					"        if (err) {",
					"            console.log('Login request failed:', err);",
					"        } else if (response.code === 200) {",
					"            const jsonData = response.json();",
					"            pm.globals.set('adminToken', jsonData.access_token);",
					"            pm.globals.set('tokenExpiry', Date.now() + (55 * 60 * 1000)); // 55 mins",
					"            console.log('Admin token refreshed successfully');",
					"        } else {",
					"            console.log('Login failed with status:', response.code);",
					"        }",
					"    });",
					"}"
				],
				"type": "text/javascript"
			}
		}
	],
	"variable": [
		{
			"key": "routeStopId",
			"value": "",
			"type": "string",
			"description": "ID of the created route stop"
		},
		{
			"key": "routeId",
			"value": "",
			"type": "string",
			"description": "ID of the route dependency"
		}
	],
	"item": [
		{
			"name": "DEPENDENCIES - Get Route for Reference",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 200', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('Response has routes array', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.be.an('array');",
							"    pm.expect(jsonData.length).to.be.greaterThan(0);",
							"});",
							"",
							"// Store first route ID for dependency",
							"if (pm.response.code === 200) {",
							"    const routes = pm.response.json();",
							"    if (routes.length > 0) {",
							"        pm.collectionVariables.set('routeId', routes[0].id);",
							"        console.log('Set routeId:', routes[0].id);",
							"    }",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "X-Client-Name",
						"value": "{{tenantName}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/masters/routes/dropdown",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"masters",
						"routes",
						"dropdown"
					]
				},
				"description": "Get available routes for dependency resolution"
			}
		},
		{
			"name": "CREATE - Create RouteStop",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 200', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('Response has required route stop fields', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('id');",
							"    pm.expect(jsonData).to.have.property('name');",
							"    pm.expect(jsonData).to.have.property('route_id');",
							"    pm.expect(jsonData).to.have.property('number');",
							"    pm.expect(jsonData).to.have.property('reaching_time');",
							"    pm.expect(jsonData).to.have.property('fees');",
							"    pm.expect(jsonData).to.have.property('is_active');",
							"});",
							"",
							"pm.test('UUID format validation', function () {",
							"    const jsonData = pm.response.json();",
							"    const uuidRegex = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;",
							"    pm.expect(jsonData.id).to.match(uuidRegex);",
							"    pm.expect(jsonData.route_id).to.match(uuidRegex);",
							"});",
							"",
							"pm.test('Created route stop has correct data', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData.name).to.eql('Central Bus Station');",
							"    pm.expect(jsonData.number).to.eql(1);",
							"    pm.expect(jsonData.reaching_time).to.eql('08:30:00');",
							"    pm.expect(jsonData.fees).to.eql(25.5);",
							"    pm.expect(jsonData.is_active).to.be.true;",
							"    pm.expect(jsonData.route_id).to.eql(pm.collectionVariables.get('routeId'));",
							"});",
							"",
							"// Store route stop ID for subsequent requests",
							"if (pm.response.code === 200) {",
							"    const jsonData = pm.response.json();",
							"    pm.collectionVariables.set('routeStopId', jsonData.id);",
							"    console.log('Created RouteStop ID:', jsonData.id);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "X-Client-Name",
						"value": "{{tenantName}}",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"route_id\": \"{{routeId}}\",\n  \"name\": \"Central Bus Station\",\n  \"number\": 1,\n  \"reaching_time\": \"08:30:00\",\n  \"fees\": 25.5,\n  \"is_active\": true\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/masters/route-stops/",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"masters",
						"route-stops",
						""
					]
				},
				"description": "Create a new route stop with dependency on Route"
			}
		},
		{
			"name": "READ - Get All RouteStops",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 200', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('Response is an array', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.be.an('array');",
							"});",
							"",
							"pm.test('Array contains our created route stop', function () {",
							"    const jsonData = pm.response.json();",
							"    const createdRouteStopId = pm.collectionVariables.get('routeStopId');",
							"    const foundRouteStop = jsonData.find(stop => stop.id === createdRouteStopId);",
							"    pm.expect(foundRouteStop).to.not.be.undefined;",
							"    pm.expect(foundRouteStop.name).to.eql('Central Bus Station');",
							"});",
							"",
							"pm.test('Each route stop has required fields', function () {",
							"    const jsonData = pm.response.json();",
							"    if (jsonData.length > 0) {",
							"        const routeStop = jsonData[0];",
							"        pm.expect(routeStop).to.have.property('id');",
							"        pm.expect(routeStop).to.have.property('name');",
							"        pm.expect(routeStop).to.have.property('route_id');",
							"        pm.expect(routeStop).to.have.property('number');",
							"        pm.expect(routeStop).to.have.property('reaching_time');",
							"        pm.expect(routeStop).to.have.property('fees');",
							"    }",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "X-Client-Name",
						"value": "{{tenantName}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/masters/route-stops/",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"masters",
						"route-stops",
						""
					]
				},
				"description": "Get all route stops"
			}
		},
		{
			"name": "READ - Get RouteStop by ID",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 200', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('Response has correct route stop data', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData.id).to.eql(pm.collectionVariables.get('routeStopId'));",
							"    pm.expect(jsonData.name).to.eql('Central Bus Station');",
							"    pm.expect(jsonData.number).to.eql(1);",
							"    pm.expect(jsonData.reaching_time).to.eql('08:30:00');",
							"    pm.expect(jsonData.fees).to.eql(25.5);",
							"    pm.expect(jsonData.is_active).to.be.true;",
							"});",
							"",
							"pm.test('Route stop has correct route reference', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData.route_id).to.eql(pm.collectionVariables.get('routeId'));",
							"});",
							"",
							"pm.test('UUID fields are valid format', function () {",
							"    const jsonData = pm.response.json();",
							"    const uuidRegex = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;",
							"    pm.expect(jsonData.id).to.match(uuidRegex);",
							"    pm.expect(jsonData.route_id).to.match(uuidRegex);",
							"});",
							"",
							"pm.test('Time field is properly formatted', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData.reaching_time).to.match(/^\\d{2}:\\d{2}:\\d{2}$/);",
							"});",
							"",
							"pm.test('Fees field is numeric', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData.fees).to.be.a('number');",
							"    pm.expect(jsonData.fees).to.be.above(0);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "X-Client-Name",
						"value": "{{tenantName}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/masters/route-stops/{{routeStopId}}",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"masters",
						"route-stops",
						"{{routeStopId}}"
					]
				},
				"description": "Get a specific route stop by ID with full details"
			}
		},
		{
			"name": "UPDATE (FULL) - Update RouteStop with PUT",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 200', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('Response shows fully updated data', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData.name).to.eql('Downtown Terminal');",
							"    pm.expect(jsonData.number).to.eql(2);",
							"    pm.expect(jsonData.reaching_time).to.eql('09:15:00');",
							"    pm.expect(jsonData.fees).to.eql(30.0);",
							"    pm.expect(jsonData.id).to.eql(pm.collectionVariables.get('routeStopId'));",
							"});",
							"",
							"pm.test('Updated route stop maintains route relationship', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData.route_id).to.eql(pm.collectionVariables.get('routeId'));",
							"    pm.expect(jsonData.is_active).to.be.true;",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "PUT",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "X-Client-Name",
						"value": "{{tenantName}}",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"route_id\": \"{{routeId}}\",\n  \"name\": \"Downtown Terminal\",\n  \"number\": 2,\n  \"reaching_time\": \"09:15:00\",\n  \"fees\": 30.0,\n  \"is_active\": true\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/masters/route-stops/{{routeStopId}}",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"masters",
						"route-stops",
						"{{routeStopId}}"
					]
				},
				"description": "Update the created route stop with complete new information (PUT - full update)"
			}
		},
		{
			"name": "UPDATE (PARTIAL) - Update RouteStop with PATCH",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 200', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('Response shows partially updated data', function () {",
							"    const jsonData = pm.response.json();",
							"    // Only fees and reaching_time should be updated",
							"    pm.expect(jsonData.fees).to.eql(35.75);",
							"    pm.expect(jsonData.reaching_time).to.eql('09:30:00');",
							"    pm.expect(jsonData.id).to.eql(pm.collectionVariables.get('routeStopId'));",
							"});",
							"",
							"pm.test('Unchanged fields remain the same', function () {",
							"    const jsonData = pm.response.json();",
							"    // These should remain unchanged from PUT update",
							"    pm.expect(jsonData.name).to.eql('Downtown Terminal');",
							"    pm.expect(jsonData.number).to.eql(2);",
							"    pm.expect(jsonData.route_id).to.eql(pm.collectionVariables.get('routeId'));",
							"    pm.expect(jsonData.is_active).to.be.true;",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "PATCH",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "X-Client-Name",
						"value": "{{tenantName}}",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"fees\": 35.75,\n  \"reaching_time\": \"09:30:00\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/masters/route-stops/{{routeStopId}}",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"masters",
						"route-stops",
						"{{routeStopId}}"
					]
				},
				"description": "Update only specific fields of the route stop (PATCH - partial update)"
			}
		},
		{
			"name": "DELETE - Delete/Deactivate RouteStop",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Note: The endpoint returns status based on service implementation",
							"// It might return 200 with deactivated data or 204 No Content",
							"pm.test('Status code is success (200 or 204)', function () {",
							"    pm.expect([200, 204]).to.include(pm.response.code);",
							"});",
							"",
							"// If response has body, check deactivation",
							"if (pm.response.text() && pm.response.text().length > 0) {",
							"    pm.test('Route stop is deactivated if response body exists', function () {",
							"        const jsonData = pm.response.json();",
							"        if (jsonData.hasOwnProperty('is_active')) {",
							"            pm.expect(jsonData.is_active).to.be.false;",
							"        }",
							"        if (jsonData.hasOwnProperty('id')) {",
							"            pm.expect(jsonData.id).to.eql(pm.collectionVariables.get('routeStopId'));",
							"        }",
							"    });",
							"}",
							"",
							"console.log('RouteStop successfully deleted/deactivated: ' + pm.collectionVariables.get('routeStopId'));"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "DELETE",
				"header": [
					{
						"key": "X-Client-Name",
						"value": "{{tenantName}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/masters/route-stops/{{routeStopId}}",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"masters",
						"route-stops",
						"{{routeStopId}}"
					]
				},
				"description": "Delete/deactivate the created route stop - cleanup operation"
			}
		}
	]
}