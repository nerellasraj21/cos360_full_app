{
	"info": {
		"_postman_id": "holiday-crud-collection-uuid",
		"name": "Level 1: Holiday CRUD Operations",
		"description": "Comprehensive CRUD operations for Holiday model with dependency on AcademicYear.\n\nDependencies:\n- AcademicYear (academic_year_id) - Level 0\n\nEndpoints tested:\n1. POST /masters/holidays - Create Holiday\n2. GET /masters/holidays - List All Holidays\n3. GET /masters/holidays/{id} - Get Holiday by ID\n4. PUT /masters/holidays/{id} - Update Holiday\n5. DELETE /masters/holidays/{id} - Deactivate Holiday\n6. PATCH /masters/holidays/{id}/activate - Activate Holiday\n7. GET /masters/holidays/dropdown - Holiday Dropdown",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{adminToken}}",
				"type": "string"
			}
		]
	},
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"exec": [
					"// Auto-refresh admin token if needed",
					"if (!pm.globals.get('adminToken') || !pm.globals.get('tokenExpiry') || ",
					"    Date.now() > parseInt(pm.globals.get('tokenExpiry'))) {",
					"    ",
					"    const loginRequest = {",
					"        url: pm.environment.get('baseUrl') + '/auth/tenant-login',",
					"        method: 'POST',",
					"        header: {",
					"            'Content-Type': 'application/json',",
					"            'X-Client-Name': pm.environment.get('tenantName')",
					"        },",
					"        body: {",
					"            mode: 'raw',",
					"            raw: JSON.stringify({",
					"                username: pm.environment.get('adminUsername'),",
					"                password: pm.environment.get('adminPassword')",
					"            })",
					"        }",
					"    };",
					"    ",
					"    pm.sendRequest(loginRequest, function(err, response) {",
					"        if (err) {",
					"            console.log('Login request failed:', err);",
					"        } else if (response.code === 200) {",
					"            const jsonData = response.json();",
					"            pm.globals.set('adminToken', jsonData.access_token);",
					"            pm.globals.set('tokenExpiry', Date.now() + (55 * 60 * 1000)); // 55 mins",
					"            console.log('Admin token refreshed successfully');",
					"        } else {",
					"            console.log('Login failed with status:', response.code);",
					"        }",
					"    });",
					"}"
				],
				"type": "text/javascript"
			}
		}
	],
	"variable": [
		{
			"key": "holidayId",
			"value": "",
			"type": "string",
			"description": "ID of the created holiday"
		},
		{
			"key": "academicYearId",
			"value": "",
			"type": "string",
			"description": "ID of the academic year dependency"
		}
	],
	"item": [
		{
			"name": "DEPENDENCIES - Get AcademicYear for Reference",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 200', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('Response has academic years array', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.be.an('array');",
							"    pm.expect(jsonData.length).to.be.greaterThan(0);",
							"});",
							"",
							"// Store first academic year ID for dependency",
							"if (pm.response.code === 200) {",
							"    const years = pm.response.json();",
							"    if (years.length > 0) {",
							"        pm.collectionVariables.set('academicYearId', years[0].id);",
							"        console.log('Set academicYearId:', years[0].id);",
							"    }",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "X-Client-Name",
						"value": "{{tenantName}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/masters/academic-years/dropdown",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"masters",
						"academic-years",
						"dropdown"
					]
				},
				"description": "Get available academic years for dependency resolution"
			}
		},
		{
			"name": "CREATE - Create Holiday",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 200', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('Response has required holiday fields', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('id');",
							"    pm.expect(jsonData).to.have.property('name');",
							"    pm.expect(jsonData).to.have.property('start_date');",
							"    pm.expect(jsonData).to.have.property('end_date');",
							"    pm.expect(jsonData).to.have.property('academic_year_id');",
							"    pm.expect(jsonData).to.have.property('is_active');",
							"});",
							"",
							"pm.test('UUID format validation', function () {",
							"    const jsonData = pm.response.json();",
							"    const uuidRegex = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;",
							"    pm.expect(jsonData.id).to.match(uuidRegex);",
							"    pm.expect(jsonData.academic_year_id).to.match(uuidRegex);",
							"});",
							"",
							"pm.test('Created holiday has correct data', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData.name).to.eql('Diwali Festival');",
							"    pm.expect(jsonData.description).to.eql('Festival of Lights celebration');",
							"    pm.expect(jsonData.start_date).to.eql('2024-11-01');",
							"    pm.expect(jsonData.end_date).to.eql('2024-11-02');",
							"    pm.expect(jsonData.is_active).to.be.false; // Default is false",
							"    pm.expect(jsonData.academic_year_id).to.eql(pm.collectionVariables.get('academicYearId'));",
							"});",
							"",
							"// Store holiday ID for subsequent requests",
							"if (pm.response.code === 200) {",
							"    const jsonData = pm.response.json();",
							"    pm.collectionVariables.set('holidayId', jsonData.id);",
							"    console.log('Created Holiday ID:', jsonData.id);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "X-Client-Name",
						"value": "{{tenantName}}",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"name\": \"Diwali Festival\",\n  \"description\": \"Festival of Lights celebration\",\n  \"start_date\": \"2024-11-01\",\n  \"end_date\": \"2024-11-02\",\n  \"is_active\": false,\n  \"academic_year_id\": \"{{academicYearId}}\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/masters/holidays/",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"masters",
						"holidays",
						""
					]
				},
				"description": "Create a new holiday with dependency on AcademicYear"
			}
		},
		{
			"name": "READ - Get All Holidays",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 200', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('Response is an array', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.be.an('array');",
							"});",
							"",
							"pm.test('Array contains our created holiday', function () {",
							"    const jsonData = pm.response.json();",
							"    const createdHolidayId = pm.collectionVariables.get('holidayId');",
							"    const foundHoliday = jsonData.find(holiday => holiday.id === createdHolidayId);",
							"    // Note: might not be found if active_only=true and holiday is inactive",
							"    console.log('Looking for holiday ID:', createdHolidayId);",
							"    console.log('Found holidays:', jsonData.length);",
							"});",
							"",
							"pm.test('Each holiday has required fields', function () {",
							"    const jsonData = pm.response.json();",
							"    if (jsonData.length > 0) {",
							"        const holiday = jsonData[0];",
							"        pm.expect(holiday).to.have.property('id');",
							"        pm.expect(holiday).to.have.property('name');",
							"        pm.expect(holiday).to.have.property('start_date');",
							"        pm.expect(holiday).to.have.property('end_date');",
							"        pm.expect(holiday).to.have.property('academic_year_id');",
							"    }",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "X-Client-Name",
						"value": "{{tenantName}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/masters/holidays/?active_only=false&limit=100",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"masters",
						"holidays",
						""
					],
					"query": [
						{
							"key": "active_only",
							"value": "false",
							"description": "Include inactive holidays to see our created one"
						},
						{
							"key": "limit",
							"value": "100"
						},
						{
							"key": "skip",
							"value": "0",
							"disabled": true
						},
						{
							"key": "academic_year_id",
							"value": "{{academicYearId}}",
							"disabled": true,
							"description": "Filter by academic year - disabled by default"
						}
					]
				},
				"description": "Get all holidays with optional filtering"
			}
		},
		{
			"name": "READ - Get Holiday by ID",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 200', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('Response has correct holiday data', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData.id).to.eql(pm.collectionVariables.get('holidayId'));",
							"    pm.expect(jsonData.name).to.eql('Diwali Festival');",
							"    pm.expect(jsonData.description).to.eql('Festival of Lights celebration');",
							"    pm.expect(jsonData.start_date).to.eql('2024-11-01');",
							"    pm.expect(jsonData.end_date).to.eql('2024-11-02');",
							"    pm.expect(jsonData.is_active).to.be.false;",
							"});",
							"",
							"pm.test('Holiday has correct academic year reference', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData.academic_year_id).to.eql(pm.collectionVariables.get('academicYearId'));",
							"});",
							"",
							"pm.test('UUID fields are valid format', function () {",
							"    const jsonData = pm.response.json();",
							"    const uuidRegex = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;",
							"    pm.expect(jsonData.id).to.match(uuidRegex);",
							"    pm.expect(jsonData.academic_year_id).to.match(uuidRegex);",
							"});",
							"",
							"pm.test('Date fields are properly formatted', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData.start_date).to.match(/^\\d{4}-\\d{2}-\\d{2}$/);",
							"    pm.expect(jsonData.end_date).to.match(/^\\d{4}-\\d{2}-\\d{2}$/);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "X-Client-Name",
						"value": "{{tenantName}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/masters/holidays/{{holidayId}}",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"masters",
						"holidays",
						"{{holidayId}}"
					]
				},
				"description": "Get a specific holiday by ID with full details"
			}
		},
		{
			"name": "PATCH - Activate Holiday",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 200', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('Holiday is now activated', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData.is_active).to.be.true;",
							"    pm.expect(jsonData.id).to.eql(pm.collectionVariables.get('holidayId'));",
							"});",
							"",
							"pm.test('Other fields remain unchanged', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData.name).to.eql('Diwali Festival');",
							"    pm.expect(jsonData.description).to.eql('Festival of Lights celebration');",
							"    pm.expect(jsonData.academic_year_id).to.eql(pm.collectionVariables.get('academicYearId'));",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "PATCH",
				"header": [
					{
						"key": "X-Client-Name",
						"value": "{{tenantName}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/masters/holidays/{{holidayId}}/activate",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"masters",
						"holidays",
						"{{holidayId}}",
						"activate"
					]
				},
				"description": "Activate the created holiday to make it active"
			}
		},
		{
			"name": "UPDATE - Update Holiday",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 200', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('Response shows updated data', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData.name).to.eql('Diwali Festival - Extended');",
							"    pm.expect(jsonData.description).to.eql('Extended Festival of Lights celebration');",
							"    pm.expect(jsonData.end_date).to.eql('2024-11-03');",
							"    pm.expect(jsonData.id).to.eql(pm.collectionVariables.get('holidayId'));",
							"});",
							"",
							"pm.test('Updated holiday maintains relationships', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData.academic_year_id).to.eql(pm.collectionVariables.get('academicYearId'));",
							"    pm.expect(jsonData.is_active).to.be.true; // Should remain active",
							"});",
							"",
							"pm.test('Start date remained unchanged', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData.start_date).to.eql('2024-11-01');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "PUT",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "X-Client-Name",
						"value": "{{tenantName}}",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"name\": \"Diwali Festival - Extended\",\n  \"description\": \"Extended Festival of Lights celebration\",\n  \"end_date\": \"2024-11-03\",\n  \"is_active\": true\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/masters/holidays/{{holidayId}}",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"masters",
						"holidays",
						"{{holidayId}}"
					]
				},
				"description": "Update the created holiday with new information"
			}
		},
		{
			"name": "DROPDOWN - Holiday Dropdown",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 200', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('Response is an array', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.be.an('array');",
							"});",
							"",
							"pm.test('Contains our created holiday (now active)', function () {",
							"    const jsonData = pm.response.json();",
							"    const createdHolidayId = pm.collectionVariables.get('holidayId');",
							"    const foundHoliday = jsonData.find(holiday => holiday.id === createdHolidayId);",
							"    pm.expect(foundHoliday).to.not.be.undefined;",
							"    pm.expect(foundHoliday.name).to.eql('Diwali Festival - Extended');",
							"});",
							"",
							"pm.test('Each dropdown item has correct structure', function () {",
							"    const jsonData = pm.response.json();",
							"    if (jsonData.length > 0) {",
							"        const holiday = jsonData[0];",
							"        pm.expect(holiday).to.have.property('id');",
							"        pm.expect(holiday).to.have.property('name');",
							"        pm.expect(Object.keys(holiday).length).to.eql(2);",
							"    }",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "X-Client-Name",
						"value": "{{tenantName}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/masters/holidays/dropdown?active_only=true",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"masters",
						"holidays",
						"dropdown"
					],
					"query": [
						{
							"key": "active_only",
							"value": "true"
						}
					]
				},
				"description": "Get holidays dropdown data (id + name only) for UI components"
			}
		},
		{
			"name": "DELETE - Deactivate Holiday",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 200', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('Holiday is now deactivated', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData.is_active).to.be.false;",
							"    pm.expect(jsonData.id).to.eql(pm.collectionVariables.get('holidayId'));",
							"});",
							"",
							"pm.test('Other holiday data remains intact', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData.name).to.eql('Diwali Festival - Extended');",
							"    pm.expect(jsonData.description).to.eql('Extended Festival of Lights celebration');",
							"    pm.expect(jsonData.academic_year_id).to.eql(pm.collectionVariables.get('academicYearId'));",
							"});",
							"",
							"console.log('Holiday successfully deactivated: ' + pm.collectionVariables.get('holidayId'));"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "DELETE",
				"header": [
					{
						"key": "X-Client-Name",
						"value": "{{tenantName}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/masters/holidays/{{holidayId}}",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"masters",
						"holidays",
						"{{holidayId}}"
					]
				},
				"description": "Deactivate the created holiday - cleanup operation (soft delete)"
			}
		}
	]
}