					"raw": "{\n  \"student_id\": \"{{studentId}}\",\n  \"student_admission_num\": \"{{studentAdmissionNum}}\",\n  \"class_id\": \"{{classId}}\",\n  \"section_id\": \"{{sectionId}}\",\n  \"fee_type_id\": \"{{feeTypeId}}\",\n  \"total_fee\": 7500.00,\n  \"academic_year_id\": \"{{academicYearId}}\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/fee/student-mappings/",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"fee",
						"student-mappings",
						""
					]
				},
				"description": "Create a new fee student mapping with dependencies on Student, FeeType, Class, Section, and AcademicYear"
			}
		},
		{
			"name": "READ - Get All FeeStudentMappings",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 200', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('Response is an array', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.be.an('array');",
							"});",
							"",
							"pm.test('Array contains our created fee student mapping', function () {",
							"    const jsonData = pm.response.json();",
							"    const createdMappingId = pm.collectionVariables.get('feeStudentMappingId');",
							"    const foundMapping = jsonData.find(mapping => mapping.id === createdMappingId);",
							"    pm.expect(foundMapping).to.not.be.undefined;",
							"    pm.expect(parseFloat(foundMapping.total_fee)).to.eql(7500.00);",
							"});",
							"",
							"pm.test('Each mapping has required fields', function () {",
							"    const jsonData = pm.response.json();",
							"    if (jsonData.length > 0) {",
							"        const mapping = jsonData[0];",
							"        pm.expect(mapping).to.have.property('id');",
							"        pm.expect(mapping).to.have.property('student_id');",
							"        pm.expect(mapping).to.have.property('class_id');",
							"        pm.expect(mapping).to.have.property('section_id');",
							"        pm.expect(mapping).to.have.property('fee_type_id');",
							"        pm.expect(mapping).to.have.property('total_fee');",
							"        pm.expect(mapping).to.have.property('academic_year_id');",
							"    }",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
