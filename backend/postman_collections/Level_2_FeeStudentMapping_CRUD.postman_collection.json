		{
			"name": "CREATE - Create FeeStudentMapping",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 201', function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"",
							"pm.test('Response has required fee student mapping fields', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('id');",
							"    pm.expect(jsonData).to.have.property('student_id');",
							"    pm.expect(jsonData).to.have.property('student_admission_num');",
							"    pm.expect(jsonData).to.have.property('class_id');",
							"    pm.expect(jsonData).to.have.property('section_id');",
							"    pm.expect(jsonData).to.have.property('fee_type_id');",
							"    pm.expect(jsonData).to.have.property('total_fee');",
							"    pm.expect(jsonData).to.have.property('academic_year_id');",
							"});",
							"",
							"pm.test('UUID format validation', function () {",
							"    const jsonData = pm.response.json();",
							"    const uuidRegex = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;",
							"    pm.expect(jsonData.id).to.match(uuidRegex);",
							"    pm.expect(jsonData.student_id).to.match(uuidRegex);",
							"    pm.expect(jsonData.class_id).to.match(uuidRegex);",
							"    pm.expect(jsonData.section_id).to.match(uuidRegex);",
							"    pm.expect(jsonData.fee_type_id).to.match(uuidRegex);",
							"    pm.expect(jsonData.academic_year_id).to.match(uuidRegex);",
							"});",
							"",
							"pm.test('Created fee student mapping has correct data', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(parseFloat(jsonData.total_fee)).to.eql(7500.00);",
							"    pm.expect(jsonData.student_id).to.eql(pm.collectionVariables.get('studentId'));",
							"    pm.expect(jsonData.student_admission_num).to.eql(pm.collectionVariables.get('studentAdmissionNum'));",
							"    pm.expect(jsonData.class_id).to.eql(pm.collectionVariables.get('classId'));",
							"    pm.expect(jsonData.section_id).to.eql(pm.collectionVariables.get('sectionId'));",
							"    pm.expect(jsonData.fee_type_id).to.eql(pm.collectionVariables.get('feeTypeId'));",
							"    pm.expect(jsonData.academic_year_id).to.eql(pm.collectionVariables.get('academicYearId'));",
							"});",
							"",
							"pm.test('Response includes related entity information', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('student_name');",
							"    pm.expect(jsonData).to.have.property('class_name');",
							"    pm.expect(jsonData).to.have.property('section_name');",
							"    pm.expect(jsonData).to.have.property('fee_type_name');",
							"    pm.expect(jsonData).to.have.property('academic_year_name');",
							"    pm.expect(jsonData).to.have.property('student_fee_mapping_terms');",
							"    pm.expect(jsonData.student_fee_mapping_terms).to.be.an('array');",
							"});",
							"",
							"// Store fee student mapping ID for subsequent requests",
							"if (pm.response.code === 201) {",
							"    const jsonData = pm.response.json();",
							"    pm.collectionVariables.set('feeStudentMappingId', jsonData.id);",
							"    console.log('Created FeeStudentMapping ID:', jsonData.id);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "X-Client-Name",
