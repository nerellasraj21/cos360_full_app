		{
			"name": "READ - Get FeeStudentMapping by ID",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 200', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('Response has correct mapping data', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData.id).to.eql(pm.collectionVariables.get('feeStudentMappingId'));",
							"    pm.expect(parseFloat(jsonData.total_fee)).to.eql(7500.00);",
							"});",
							"",
