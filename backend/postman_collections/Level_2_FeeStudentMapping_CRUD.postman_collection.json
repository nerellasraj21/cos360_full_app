	"item": [
		{
			"name": "DEPENDENCIES - Get Student for Reference",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 200', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('Response has students array', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.be.an('array');",
							"    pm.expect(jsonData.length).to.be.greaterThan(0);",
							"});",
							"",
							"// Store first student data for dependency",
							"if (pm.response.code === 200) {",
							"    const students = pm.response.json();",
							"    if (students.length > 0) {",
							"        pm.collectionVariables.set('studentId', students[0].id);",
							"        // Try to get admission number from student data",
							"        if (students[0].admission_number) {",
							"            pm.collectionVariables.set('studentAdmissionNum', students[0].admission_number);",
							"        } else {",
							"            // Use placeholder - will need actual admission number",
							"            pm.collectionVariables.set('studentAdmissionNum', 'ADM001');",
							"        }",
							"        console.log('Set studentId:', students[0].id);",
							"        console.log('Set studentAdmissionNum:', pm.collectionVariables.get('studentAdmissionNum'));",
							"    }",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
