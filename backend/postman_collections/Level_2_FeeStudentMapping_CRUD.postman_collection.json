{
	"info": {
		"_postman_id": "fee-student-mapping-crud-collection-uuid",
		"name": "Level 2: FeeStudentMapping CRUD Operations",
		"description": "Comprehensive CRUD operations for FeeStudentMapping model with dependencies on multiple entities.\n\nDependencies:\n- Student (student_id + student_admission_num) - Complex Student Entity\n- FeeType (fee_type_id) - Level 2\n- Class (class_id) - Level 1\n- Section (section_id) - Level 1\n- AcademicYear (academic_year_id) - Level 0\n\nEndpoints tested:\n1. POST /fee/student-mappings - Create FeeStudentMapping\n2. GET /fee/student-mappings - List All FeeStudentMappings (with filters)\n3. GET /fee/student-mappings/{id} - Get FeeStudentMapping by ID\n4. PUT /fee/student-mappings/{id} - Update FeeStudentMapping\n5. DELETE /fee/student-mappings/{id} - Delete FeeStudentMapping\n6. POST /fee/student-mappings/bulk - Bulk Create FeeStudentMappings",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{adminToken}}",
				"type": "string"
			}
		]
	},
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"exec": [
					"// Auto-refresh admin token if needed",
					"if (!pm.globals.get('adminToken') || !pm.globals.get('tokenExpiry') || ",
					"    Date.now() > parseInt(pm.globals.get('tokenExpiry'))) {",
					"    ",
					"    const loginRequest = {",
					"        url: pm.environment.get('baseUrl') + '/auth/tenant-login',",
					"        method: 'POST',",
					"        header: {",
					"            'Content-Type': 'application/json',",
					"            'X-Client-Name': pm.environment.get('tenantName')",
					"        },",
					"        body: {",
					"            mode: 'raw',",
					"            raw: JSON.stringify({",
					"                username: pm.environment.get('adminUsername'),",
					"                password: pm.environment.get('adminPassword')",
					"            })",
					"        }",
					"    };",
					"    ",
					"    pm.sendRequest(loginRequest, function(err, response) {",
					"        if (err) {",
					"            console.log('Login request failed:', err);",
					"        } else if (response.code === 200) {",
					"            const jsonData = response.json();",
					"            pm.globals.set('adminToken', jsonData.access_token);",
					"            pm.globals.set('tokenExpiry', Date.now() + (55 * 60 * 1000)); // 55 mins",
					"            console.log('Admin token refreshed successfully');",
					"        } else {",
					"            console.log('Login failed with status:', response.code);",
					"        }",
					"    });",
					"}"
				],
				"type": "text/javascript"
			}
		}
	],
	"variable": [
		{
			"key": "feeStudentMappingId",
			"value": "",
			"type": "string",
			"description": "ID of the created fee student mapping"
		},
