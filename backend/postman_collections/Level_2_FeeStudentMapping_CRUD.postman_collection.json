						"value": "{{tenantName}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/student/admissions/?limit=5",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"student",
						"admissions",
						""
					],
					"query": [
