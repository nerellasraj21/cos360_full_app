							"    const jsonData = pm.response.json();",
							"    const uuidRegex = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;",
							"    pm.expect(jsonData.id).to.match(uuidRegex);",
							"    pm.expect(jsonData.student.id).to.match(uuidRegex);",
							"    pm.expect(jsonData.academic_year_id).to.match(uuidRegex);",
							"});",
							"",
							"pm.test('Dependencies are correctly set', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData.academic_year_id).to.eql(pm.collectionVariables.get('academicYearId'));",
							"    pm.expect(jsonData.admitted_class_id).to.eql(pm.collectionVariables.get('classId1'));",
							"    pm.expect(jsonData.current_class_id).to.eql(pm.collectionVariables.get('classId2'));",
							"});",
							"",
							"pm.test('Address information is present', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData.address_line1).to.eql('123 Test Street');",
							"    pm.expect(jsonData.city).to.eql('Test City');",
