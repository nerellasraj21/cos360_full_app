							"    pm.expect(jsonData).to.have.property('admitted_class_id');",
							"    pm.expect(jsonData).to.have.property('current_class_id');",
							"    pm.expect(jsonData).to.have.property('address_line1');",
							"    pm.expect(jsonData).to.have.property('city');",
							"    pm.expect(jsonData).to.have.property('state');",
							"});",
							"",
							"pm.test('Student has required fields', function () {",
							"    const jsonData = pm.response.json();",
							"    const student = jsonData.student;",
							"    pm.expect(student).to.have.property('first_name');",
							"    pm.expect(student).to.have.property('last_name');",
							"    pm.expect(student).to.have.property('date_of_birth');",
							"    pm.expect(student).to.have.property('gender');",
							"    pm.expect(student).to.have.property('roll_number');",
							"});",
							"",
