{
	"info": {
		"_postman_id": "admission-crud-collection-uuid",
		"name": "Level 2: Admission CRUD Operations",
		"description": "Comprehensive CRUD operations for Admission model with dependencies on multiple entities.\n\nDependencies:\n- Student (embedded creation) - Inline creation\n- AcademicYear (academic_year_id) - Level 0\n- Class (admitted_class_id, current_class_id) - Level 1\n- Section (admitted_section_id, current_section_id) - Level 1\n\nSpecialized Endpoints:\n1. POST /students/admission/ - Create Admission (with embedded Student creation)\n2. GET /students/admission/id/{student_id} - Get Admission by Student ID\n3. PATCH /students/admission/{student_id} - Update Admission\n4. GET /students/admission/by-admission/{admission_id} - Get Student by Admission ID\n5. GET /students/admission/search?query= - Search Students\n\nNote: This model handles both student creation and admission in a single operation with complex relationships.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{adminToken}}",
				"type": "string"
			}
		]
	},
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"exec": [
					"// Auto-refresh admin token if needed",
					"if (!pm.globals.get('adminToken') || !pm.globals.get('tokenExpiry') || ",
					"    Date.now() > parseInt(pm.globals.get('tokenExpiry'))) {",
					"    ",
					"    const loginRequest = {",
					"        url: pm.environment.get('baseUrl') + '/auth/tenant-login',",
					"        method: 'POST',",
					"        header: {",
					"            'Content-Type': 'application/json',",
					"            'X-Client-Name': pm.environment.get('tenantName')",
					"        },",
					"        body: {",
					"            mode: 'raw',",
					"            raw: JSON.stringify({",
					"                username: pm.environment.get('adminUsername'),",
					"                password: pm.environment.get('adminPassword')",
					"            })",
					"        }",
					"    };",
					"    ",
					"    pm.sendRequest(loginRequest, function(err, response) {",
					"        if (err) {",
					"            console.log('Login request failed:', err);",
					"        } else if (response.code === 200) {",
					"            const jsonData = response.json();",
					"            pm.globals.set('adminToken', jsonData.access_token);",
					"            pm.globals.set('tokenExpiry', Date.now() + (55 * 60 * 1000)); // 55 mins",
					"            console.log('Admin token refreshed successfully');",
					"        } else {",
					"            console.log('Login failed with status:', response.code);",
					"        }",
					"    });",
					"}"
				],
				"type": "text/javascript"
			}
		}
	],
