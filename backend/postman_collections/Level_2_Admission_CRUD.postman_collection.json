							"    pm.expect(jsonData).to.have.property('id');",
							"    pm.expect(jsonData).to.have.property('student');",
							"    pm.expect(jsonData.student).to.have.property('id');",
							"});",
							"",
							"pm.test('Admission has required fields', function () {",
