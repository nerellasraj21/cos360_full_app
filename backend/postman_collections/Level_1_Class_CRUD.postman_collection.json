			"request": {
				"method": "GET",
				"header": [{"key": "cschema", "value": "{{tenant_schema}}"}],
				"url": {
					"raw": "{{base_url}}/api/v1/masters/class_sections/sections-by-class-name?class_name=Grade 10",
					"host": ["{{base_url}}"],
					"path": ["api", "v1", "masters", "class_sections", "sections-by-class-name"],
					"query": [{"key": "class_name", "value": "Grade 10"}]
				},
				"description": "Get sections filtered by class name"
			}
		},
		{
			"name": "8. UPDATE Class",
			"event": [{
				"listen": "test",
				"script": {
					"exec": [
						"pm.test('Status code is 200', function () {",
						"    pm.response.to.have.status(200);",
						"});",
						"pm.test('Class updated successfully', function () {",
						"    var jsonData = pm.response.json();",
						"    console.log('Class update response:', jsonData);",
						"});"
					]
				}
			}],
			"request": {
				"method": "PUT",
				"header": [
					{"key": "Content-Type", "value": "application/json"},
					{"key": "cschema", "value": "{{tenant_schema}}"}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"name\": \"Updated Grade 10\",\n    \"description\": \"Updated tenth grade class\",\n    \"is_active\": true,\n    \"short_code\": \"UG10\",\n    \"academic_year_id\": \"{{created_academic_year_id}}\"\n}"
				},
				"url": "{{base_url}}/api/v1/masters/class_sections/{{created_class_id}}",
				"description": "Update existing class"
			}
		},
		{
			"name": "9. DELETE Class",
			"event": [{
				"listen": "test",
				"script": {
					"exec": [
						"pm.test('Status code is 204 No Content', function () {",
						"    pm.response.to.have.status(204);",
						"});",
						"pm.test('Class deletion confirmed', function () {",
						"    console.log('Class deleted successfully (cascade delete for sections)');",
						"    // Clear the variable since record is deleted",
						"    pm.globals.unset('created_class_id');",
						"});"
					]
				}
			}],
			"request": {
