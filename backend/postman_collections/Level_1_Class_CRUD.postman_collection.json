						"});",
						"pm.test('Class-section info returned', function () {",
						"    var jsonData = pm.response.json();",
						"    pm.expect(jsonData).to.be.an('array');",
						"    console.log('Class-section list retrieved');",
						"});"
					]
				}
			}],
			"request": {
				"method": "GET",
				"header": [{"key": "cschema", "value": "{{tenant_schema}}"}],
				"url": "{{base_url}}/api/v1/masters/class_sections/class-section-list",
				"description": "Get class-section information list"
			}
		},
		{
			"name": "5. GET Classes Only (Dropdown Format)",
			"event": [{
