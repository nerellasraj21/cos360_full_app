						"});",
						"pm.test('Classes dropdown format correct', function () {",
						"    var jsonData = pm.response.json();",
						"    pm.expect(jsonData).to.be.an('array');",
						"    if (jsonData.length > 0) {",
						"        pm.expect(jsonData[0].id).to.exist;",
						"        pm.expect(jsonData[0].name).to.exist;",
						"    }",
						"});"
					]
				}
			}],
			"request": {
				"method": "GET",
				"header": [{"key": "cschema", "value": "{{tenant_schema}}"}],
				"url": "{{base_url}}/api/v1/masters/class_sections/dropdown?active_only=true",
				"description": "Get classes dropdown (id + name only)"
			}
		},
		{
			"name": "6. GET Sections by Class ID",
			"event": [{
				"listen": "test",
