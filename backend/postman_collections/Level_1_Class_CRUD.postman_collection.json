				"header": [{"key": "cschema", "value": "{{tenant_schema}}"}],
				"url": "{{base_url}}/api/v1/masters/class_sections/{{created_class_id}}",
				"description": "Delete class (cascade deletes associated sections)"
			}
		},
		{
			"name": "10. [CLEANUP] Delete Test Academic Year",
			"event": [{
				"listen": "test",
				"script": {
					"exec": [
						"pm.test('Cleanup successful', function () {",
						"    pm.response.to.have.status(200);",
						"    pm.globals.unset('created_academic_year_id');",
						"    console.log('✅ Test cleanup completed');",
						"});"
					]
				}
			}],
			"request": {
				"method": "DELETE",
				"header": [{"key": "cschema", "value": "{{tenant_schema}}"}],
