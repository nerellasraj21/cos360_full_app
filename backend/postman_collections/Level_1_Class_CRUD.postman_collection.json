						"});"
					]
				}
			}],
			"request": {
				"method": "GET",
				"header": [{"key": "cschema", "value": "{{tenant_schema}}"}],
				"url": "{{base_url}}/api/v1/masters/class_sections/by_class_id/{{created_class_id}}/sections",
				"description": "Get sections dropdown by class ID"
			}
		},
