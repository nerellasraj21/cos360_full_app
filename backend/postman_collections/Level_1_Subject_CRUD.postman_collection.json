{
	"info": {
		"_postman_id": "subject-crud-collection-uuid",
		"name": "Level 1: Subject CRUD Operations",
		"description": "Comprehensive CRUD operations for Subject model with dependencies on SubjectCategory and AcademicYear.\n\nDependencies:\n- SubjectCategory (category_id) - Level 0\n- AcademicYear (academic_year_id) - Level 0\n\nEndpoints tested:\n1. POST /masters/subjects - Create Subject\n2. GET /masters/subjects - List All Subjects\n3. GET /masters/subjects/{id} - Get Subject by ID\n4. PUT /masters/subjects/{id} - Update Subject\n5. DELETE /masters/subjects/{id} - Delete/Deactivate Subject\n6. GET /masters/subjects/dropdown - Subject Dropdown\n7. GET /masters/subjects/categories - Subject Categories\n8. GET /masters/subjects/by-academic-year/{year_id} - Subjects by Academic Year\n9. GET /masters/subjects/categories/{category_id}/subjects/dropdown - Subjects by Category Dropdown",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{adminToken}}",
				"type": "string"
			}
		]
	},
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"exec": [
					"// Auto-refresh admin token if needed",
					"if (!pm.globals.get('adminToken') || !pm.globals.get('tokenExpiry') || ",
					"    Date.now() > parseInt(pm.globals.get('tokenExpiry'))) {",
					"    ",
					"    const loginRequest = {",
					"        url: pm.environment.get('baseUrl') + '/auth/tenant-login',",
					"        method: 'POST',",
					"        header: {",
					"            'Content-Type': 'application/json',",
					"            'X-Client-Name': pm.environment.get('tenantName')",
					"        },",
					"        body: {",
					"            mode: 'raw',",
					"            raw: JSON.stringify({",
					"                username: pm.environment.get('adminUsername'),",
					"                password: pm.environment.get('adminPassword')",
					"            })",
					"        }",
					"    };",
					"    ",
					"    pm.sendRequest(loginRequest, function(err, response) {",
					"        if (err) {",
					"            console.log('Login request failed:', err);",
					"        } else if (response.code === 200) {",
					"            const jsonData = response.json();",
					"            pm.globals.set('adminToken', jsonData.access_token);",
					"            pm.globals.set('tokenExpiry', Date.now() + (55 * 60 * 1000)); // 55 mins",
					"            console.log('Admin token refreshed successfully');",
					"        } else {",
					"            console.log('Login failed with status:', response.code);",
					"        }",
					"    });",
					"}"
				],
				"type": "text/javascript"
			}
		}
	],
	"variable": [
		{
			"key": "subjectId",
			"value": "",
			"type": "string",
			"description": "ID of the created subject"
		},
		{
			"key": "subjectCategoryId",
			"value": "",
			"type": "string",
			"description": "ID of the subject category dependency"
		},
		{
			"key": "academicYearId",
			"value": "",
			"type": "string",
			"description": "ID of the academic year dependency"
		}
	],
	"item": [
		{
			"name": "DEPENDENCIES - Get SubjectCategory for Reference",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 200', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('Response has subject categories array', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.be.an('array');",
							"    pm.expect(jsonData.length).to.be.greaterThan(0);",
							"});",
							"",
							"// Store first subject category ID for dependency",
							"if (pm.response.code === 200) {",
							"    const categories = pm.response.json();",
							"    if (categories.length > 0) {",
							"        pm.collectionVariables.set('subjectCategoryId', categories[0].id);",
							"        console.log('Set subjectCategoryId:', categories[0].id);",
							"    }",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "X-Client-Name",
						"value": "{{tenantName}}",
						"type": "text"
					}
