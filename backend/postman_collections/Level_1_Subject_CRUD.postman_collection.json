		{
			"name": "CREATE - Create Subject",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 200', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('Response has required subject fields', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('id');",
							"    pm.expect(jsonData).to.have.property('name');",
							"    pm.expect(jsonData).to.have.property('category_id');",
							"    pm.expect(jsonData).to.have.property('academic_year_id');",
							"    pm.expect(jsonData).to.have.property('is_active');",
							"});",
							"",
							"pm.test('UUID format validation', function () {",
							"    const jsonData = pm.response.json();",
							"    const uuidRegex = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;",
							"    pm.expect(jsonData.id).to.match(uuidRegex);",
							"    pm.expect(jsonData.category_id).to.match(uuidRegex);",
							"    pm.expect(jsonData.academic_year_id).to.match(uuidRegex);",
							"});",
							"",
							"pm.test('Created subject has correct data', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData.name).to.eql('Mathematics');",
							"    pm.expect(jsonData.short_code).to.eql('MATH');",
							"    pm.expect(jsonData.is_active).to.be.true;",
							"    pm.expect(jsonData.category_id).to.eql(pm.collectionVariables.get('subjectCategoryId'));",
							"    pm.expect(jsonData.academic_year_id).to.eql(pm.collectionVariables.get('academicYearId'));",
							"});",
							"",
							"// Store subject ID for subsequent requests",
							"if (pm.response.code === 200) {",
							"    const jsonData = pm.response.json();",
							"    pm.collectionVariables.set('subjectId', jsonData.id);",
							"    console.log('Created Subject ID:', jsonData.id);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
