							"});",
							"",
							"pm.test('Response has fee terms array', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.be.an('array');",
							"    pm.expect(jsonData.length).to.be.greaterThan(0);",
							"});",
							"",
							"// Store multiple fee term IDs for bulk operations",
							"if (pm.response.code === 200) {",
							"    const terms = pm.response.json();",
							"    if (terms.length > 0) {",
							"        pm.collectionVariables.set('feeTermId1', terms[0].id);",
							"        console.log('Set feeTermId1:', terms[0].id);",
							"        ",
							"        if (terms.length > 1) {",
							"            pm.collectionVariables.set('feeTermId2', terms[1].id);",
							"            console.log('Set feeTermId2:', terms[1].id);",
							"        } else {",
							"            // Use same term ID if only one available",
							"            pm.collectionVariables.set('feeTermId2', terms[0].id);",
							"            console.log('Set feeTermId2 (same as 1):', terms[0].id);",
							"        }",
							"    }",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
