		{
			"name": "UPDATE (BULK) - Update Fee Class Mapping Term Amounts",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 200', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('Response is an array', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.be.an('array');",
							"    pm.expect(jsonData.length).to.be.greaterThan(0);",
							"});",
							"",
							"pm.test('Updated term amounts show new values', function () {",
							"    const jsonData = pm.response.json();",
							"    // Find the updated term amounts",
							"    const termAmount1Id = pm.collectionVariables.get('termAmountId1');",
							"    const termAmount2Id = pm.collectionVariables.get('termAmountId2');",
							"    ",
							"    const updatedAmount1 = jsonData.find(item => item.id === termAmount1Id);",
							"    const updatedAmount2 = jsonData.find(item => item.id === termAmount2Id);",
							"    ",
							"    if (updatedAmount1) {",
							"        pm.expect(parseFloat(updatedAmount1.term_amount)).to.eql(2750.50);",
							"    }",
							"    if (updatedAmount2) {",
							"        pm.expect(parseFloat(updatedAmount2.term_amount)).to.eql(3250.75);",
							"    }",
							"});",
							"",
							"pm.test('Updated term amounts maintain relationships', function () {",
							"    const jsonData = pm.response.json();",
							"    jsonData.forEach(termAmount => {",
							"        pm.expect(termAmount.fee_class_mapping_id).to.eql(pm.collectionVariables.get('feeClassMappingId'));",
							"        pm.expect(termAmount).to.have.property('term_name');",
							"    });",
							"});",
							"",
							"pm.test('All term amounts are positive', function () {",
							"    const jsonData = pm.response.json();",
							"    jsonData.forEach(termAmount => {",
							"        pm.expect(parseFloat(termAmount.term_amount)).to.be.above(0);",
							"    });",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
