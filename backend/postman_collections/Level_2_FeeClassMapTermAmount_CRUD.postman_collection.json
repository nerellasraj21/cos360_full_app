							"    if (termAmounts.length > 0) {",
							"        termAmounts.forEach(termAmount => {",
							"            pm.expect(termAmount).to.have.property('id');",
							"            pm.expect(termAmount).to.have.property('term_id');",
							"            pm.expect(termAmount).to.have.property('term_amount');",
							"            pm.expect(parseFloat(termAmount.term_amount)).to.be.above(0);",
							"        });",
							"    }",
							"});",
							"",
							"pm.test('Verify our updated term amounts are present', function () {",
							"    const jsonData = pm.response.json();",
							"    const termAmounts = jsonData.class_fee_mapping_terms;",
							"    const termAmount1Id = pm.collectionVariables.get('termAmountId1');",
							"    const termAmount2Id = pm.collectionVariables.get('termAmountId2');",
							"    ",
							"    const foundAmount1 = termAmounts.find(item => item.id === termAmount1Id);",
							"    const foundAmount2 = termAmounts.find(item => item.id === termAmount2Id);",
							"    ",
							"    if (foundAmount1) {",
							"        pm.expect(parseFloat(foundAmount1.term_amount)).to.eql(2750.50);",
							"    }",
							"    if (foundAmount2) {",
							"        pm.expect(parseFloat(foundAmount2.term_amount)).to.eql(3250.75);",
							"    }",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
