					"script": {
						"exec": [
							"// Note: The endpoint might return different status codes based on service implementation",
							"pm.test('Status code indicates successful deletion', function () {",
							"    pm.expect([200, 204]).to.include(pm.response.code);",
							"});",
							"",
							"// If response has body, validate it",
							"if (pm.response.text() && pm.response.text().length > 0) {",
							"    pm.test('Response body indicates successful deletion if present', function () {",
							"        const responseText = pm.response.text();",
							"        try {",
							"            const jsonData = JSON.parse(responseText);",
							"            pm.expect(jsonData).to.be.an('object');",
							"        } catch (e) {",
							"            // If not JSON, just check it's not empty",
							"            pm.expect(responseText).to.not.be.empty;",
							"        }",
							"    });",
							"}",
							"",
							"console.log('FeeClassMapTermAmounts successfully deleted:', pm.collectionVariables.get('termAmountId1'), pm.collectionVariables.get('termAmountId2'));"
						],
