{
	"info": {
		"_postman_id": "fee-class-map-term-amount-crud-collection-uuid",
		"name": "Level 2: FeeClassMapTermAmount CRUD Operations",
		"description": "Comprehensive CRUD operations for FeeClassMapTermAmount model with dependencies on multiple entities.\n\nDependencies:\n- FeeClassMapping (fee_class_mapping_id) - Level 2\n- FeeTerm (term_id) - Level 1\n\nSpecialized Endpoints (Bulk Operations Only):\n1. POST /fee/class-mapping-term-amounts - Create Bulk Term Amounts\n2. PUT /fee/class-mapping-term-amounts - Update Bulk Term Amounts\n3. DELETE /fee/class-mapping-term-amounts - Delete Bulk Term Amounts\n\nNote: This model only supports bulk operations as term amounts are typically managed in groups per fee class mapping.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{adminToken}}",
				"type": "string"
			}
		]
	},
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"exec": [
					"// Auto-refresh admin token if needed",
					"if (!pm.globals.get('adminToken') || !pm.globals.get('tokenExpiry') || ",
					"    Date.now() > parseInt(pm.globals.get('tokenExpiry'))) {",
					"    ",
					"    const loginRequest = {",
					"        url: pm.environment.get('baseUrl') + '/auth/tenant-login',",
					"        method: 'POST',",
					"        header: {",
					"            'Content-Type': 'application/json',",
					"            'X-Client-Name': pm.environment.get('tenantName')",
					"        },",
					"        body: {",
					"            mode: 'raw',",
					"            raw: JSON.stringify({",
					"                username: pm.environment.get('adminUsername'),",
					"                password: pm.environment.get('adminPassword')",
					"            })",
					"        }",
					"    };",
					"    ",
					"    pm.sendRequest(loginRequest, function(err, response) {",
					"        if (err) {",
					"            console.log('Login request failed:', err);",
					"        } else if (response.code === 200) {",
					"            const jsonData = response.json();",
					"            pm.globals.set('adminToken', jsonData.access_token);",
					"            pm.globals.set('tokenExpiry', Date.now() + (55 * 60 * 1000)); // 55 mins",
					"            console.log('Admin token refreshed successfully');",
					"        } else {",
					"            console.log('Login failed with status:', response.code);",
					"        }",
					"    });",
					"}"
				],
				"type": "text/javascript"
			}
		}
	],
	"variable": [
		{
			"key": "feeClassMappingId",
			"value": "",
			"type": "string",
			"description": "ID of the fee class mapping dependency"
		},
		{
			"key": "feeTermId1",
			"value": "",
			"type": "string",
			"description": "ID of the first fee term dependency"
		},
		{
			"key": "feeTermId2",
			"value": "",
			"type": "string",
			"description": "ID of the second fee term dependency"
		},
		{
