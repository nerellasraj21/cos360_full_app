			"value": "",
			"type": "string",
			"description": "ID of the first created term amount"
		},
		{
			"key": "termAmountId2",
			"value": "",
			"type": "string",
			"description": "ID of the second created term amount"
		}
	],
	"item": [
		{
			"name": "DEPENDENCIES - Get FeeClassMapping for Reference",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 200', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('Response has fee class mappings array', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.be.an('array');",
							"    pm.expect(jsonData.length).to.be.greaterThan(0);",
							"});",
							"",
							"// Store first fee class mapping ID for dependency",
							"if (pm.response.code === 200) {",
							"    const mappings = pm.response.json();",
							"    if (mappings.length > 0) {",
							"        pm.collectionVariables.set('feeClassMappingId', mappings[0].id);",
							"        console.log('Set feeClassMappingId:', mappings[0].id);",
							"    }",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "X-Client-Name",
						"value": "{{tenantName}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/fee/class-mappings/?limit=5",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"fee",
						"class-mappings",
						""
					],
					"query": [
						{
							"key": "limit",
							"value": "5"
						}
					]
				},
				"description": "Get available fee class mappings for dependency resolution"
			}
		},
		{
			"name": "DEPENDENCIES - Get FeeTerms for Reference",
			"event": [
				{
