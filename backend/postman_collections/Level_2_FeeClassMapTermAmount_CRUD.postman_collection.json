		{
			"name": "CREATE (BULK) - Create Fee Class Mapping Term Amounts",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 201', function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"",
							"pm.test('Response is an array', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.be.an('array');",
							"    pm.expect(jsonData.length).to.eql(2); // Created 2 term amounts",
							"});",
							"",
							"pm.test('Each term amount has required fields', function () {",
							"    const jsonData = pm.response.json();",
							"    jsonData.forEach(termAmount => {",
							"        pm.expect(termAmount).to.have.property('id');",
							"        pm.expect(termAmount).to.have.property('fee_class_mapping_id');",
							"        pm.expect(termAmount).to.have.property('term_id');",
							"        pm.expect(termAmount).to.have.property('term_amount');",
							"        pm.expect(termAmount).to.have.property('term_name');",
							"    });",
							"});",
							"",
							"pm.test('UUID format validation', function () {",
							"    const jsonData = pm.response.json();",
							"    const uuidRegex = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;",
							"    jsonData.forEach(termAmount => {",
							"        pm.expect(termAmount.id).to.match(uuidRegex);",
							"        pm.expect(termAmount.fee_class_mapping_id).to.match(uuidRegex);",
							"        pm.expect(termAmount.term_id).to.match(uuidRegex);",
							"    });",
							"});",
							"",
							"pm.test('Created term amounts have correct data', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(parseFloat(jsonData[0].term_amount)).to.eql(2500.00);",
							"    pm.expect(parseFloat(jsonData[1].term_amount)).to.eql(3000.00);",
							"    ",
							"    jsonData.forEach(termAmount => {",
							"        pm.expect(termAmount.fee_class_mapping_id).to.eql(pm.collectionVariables.get('feeClassMappingId'));",
							"    });",
							"});",
							"",
							"pm.test('Term amounts are positive', function () {",
							"    const jsonData = pm.response.json();",
							"    jsonData.forEach(termAmount => {",
							"        pm.expect(parseFloat(termAmount.term_amount)).to.be.above(0);",
							"    });",
							"});",
							"",
							"// Store term amount IDs for subsequent requests",
							"if (pm.response.code === 201) {",
							"    const jsonData = pm.response.json();",
							"    if (jsonData.length > 0) {",
							"        pm.collectionVariables.set('termAmountId1', jsonData[0].id);",
							"        console.log('Created Term Amount 1 ID:', jsonData[0].id);",
							"        ",
							"        if (jsonData.length > 1) {",
							"            pm.collectionVariables.set('termAmountId2', jsonData[1].id);",
							"            console.log('Created Term Amount 2 ID:', jsonData[1].id);",
							"        }",
							"    }",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
