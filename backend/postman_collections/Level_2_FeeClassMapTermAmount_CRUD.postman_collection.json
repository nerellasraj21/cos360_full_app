			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 200', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('Term amounts have been removed', function () {",
							"    const jsonData = pm.response.json();",
							"    const termAmounts = jsonData.class_fee_mapping_terms || [];",
							"    const termAmount1Id = pm.collectionVariables.get('termAmountId1');",
							"    const termAmount2Id = pm.collectionVariables.get('termAmountId2');",
							"    ",
							"    const foundAmount1 = termAmounts.find(item => item.id === termAmount1Id);",
							"    const foundAmount2 = termAmounts.find(item => item.id === termAmount2Id);",
							"    ",
							"    pm.expect(foundAmount1).to.be.undefined;",
							"    pm.expect(foundAmount2).to.be.undefined;",
							"    ",
