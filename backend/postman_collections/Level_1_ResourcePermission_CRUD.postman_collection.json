			"name": "DEPENDENCIES - Get Role for Reference",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 200', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('Response has roles array', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.be.an('array');",
							"    pm.expect(jsonData.length).to.be.greaterThan(0);",
							"});",
							"",
							"// Store first role ID for dependency",
							"if (pm.response.code === 200) {",
							"    const roles = pm.response.json();",
							"    if (roles.length > 0) {",
							"        pm.collectionVariables.set('roleId', roles[0].id);",
							"        console.log('Set roleId:', roles[0].id, 'Name:', roles[0].name);",
							"    }",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
