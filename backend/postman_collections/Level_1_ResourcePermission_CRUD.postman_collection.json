		{
			"name": "CREATE - Create ResourcePermission",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 201', function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"",
							"pm.test('Response has required resource permission fields', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('id');",
							"    pm.expect(jsonData).to.have.property('role_id');",
							"    pm.expect(jsonData).to.have.property('resource');",
							"    pm.expect(jsonData).to.have.property('action');",
							"    pm.expect(jsonData).to.have.property('is_granted');",
							"    pm.expect(jsonData).to.have.property('created_at');",
							"    pm.expect(jsonData).to.have.property('updated_at');",
							"});",
							"",
							"pm.test('UUID format validation', function () {",
							"    const jsonData = pm.response.json();",
							"    const uuidRegex = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;",
							"    pm.expect(jsonData.id).to.match(uuidRegex);",
							"    pm.expect(jsonData.role_id).to.match(uuidRegex);",
							"});",
							"",
							"pm.test('Created resource permission has correct data', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData.resource).to.eql(pm.collectionVariables.get('testResource'));",
							"    pm.expect(jsonData.action).to.eql(pm.collectionVariables.get('testAction'));",
							"    pm.expect(jsonData.is_granted).to.be.true;",
							"    pm.expect(jsonData.role_id).to.eql(pm.collectionVariables.get('roleId'));",
							"});",
							"",
							"// Store permission ID for subsequent requests",
							"if (pm.response.code === 201) {",
							"    const jsonData = pm.response.json();",
							"    pm.collectionVariables.set('resourcePermissionId', jsonData.id);",
							"    console.log('Created ResourcePermission ID:', jsonData.id);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
