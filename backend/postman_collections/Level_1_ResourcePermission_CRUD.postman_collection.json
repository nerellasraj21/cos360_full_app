		{
			"name": "UTILITY - Check Permission Exists",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 200', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('Response has permission check data', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('role_id');",
							"    pm.expect(jsonData).to.have.property('resource');",
							"    pm.expect(jsonData).to.have.property('action');",
							"    pm.expect(jsonData).to.have.property('permission_granted');",
