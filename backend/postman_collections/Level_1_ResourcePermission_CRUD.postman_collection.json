{
	"info": {
		"_postman_id": "resource-permission-crud-collection-uuid",
		"name": "Level 1: ResourcePermission CRUD Operations",
		"description": "Comprehensive CRUD operations for ResourcePermission model with dependency on Role.\n\nDependencies:\n- Role (role_id) - Level 0\n\nEndpoints tested (15 endpoints):\n1. POST /auth/resource-permissions - Create ResourcePermission\n2. GET /auth/resource-permissions - List All ResourcePermissions\n3. GET /auth/resource-permissions/{id} - Get ResourcePermission by ID\n4. PUT /auth/resource-permissions/{id} - Update ResourcePermission\n5. DELETE /auth/resource-permissions/{id} - Delete ResourcePermission\n6. GET /auth/resource-permissions/role/{role_id} - Get Permissions by Role\n7. GET /auth/resource-permissions/resource/{resource} - Get Permissions by Resource\n8. POST /auth/resource-permissions/bulk - Bulk Create Permissions\n9. GET /auth/resource-permissions/role/{role_id}/summary - Role Permission Summary\n10. GET /auth/resource-permissions/matrix/all - Permission Matrix\n11. DELETE /auth/resource-permissions/role/{role_id}/all - Delete All Permissions for Role\n12. DELETE /auth/resource-permissions/resource/{resource}/all - Delete All Permissions for Resource\n13. GET /auth/resource-permissions/dropdown/resources - Available Resources Dropdown\n14. GET /auth/resource-permissions/dropdown/actions - Available Actions Dropdown\n15. GET /auth/resource-permissions/check/{role_id}/{resource}/{action} - Check Permission",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{adminToken}}",
				"type": "string"
			}
		]
	},
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"exec": [
					"// Auto-refresh admin token if needed",
					"if (!pm.globals.get('adminToken') || !pm.globals.get('tokenExpiry') || ",
					"    Date.now() > parseInt(pm.globals.get('tokenExpiry'))) {",
					"    ",
					"    const loginRequest = {",
					"        url: pm.environment.get('baseUrl') + '/auth/tenant-login',",
					"        method: 'POST',",
					"        header: {",
					"            'Content-Type': 'application/json',",
					"            'X-Client-Name': pm.environment.get('tenantName')",
					"        },",
					"        body: {",
					"            mode: 'raw',",
					"            raw: JSON.stringify({",
					"                username: pm.environment.get('adminUsername'),",
					"                password: pm.environment.get('adminPassword')",
					"            })",
					"        }",
					"    };",
					"    ",
					"    pm.sendRequest(loginRequest, function(err, response) {",
					"        if (err) {",
					"            console.log('Login request failed:', err);",
					"        } else if (response.code === 200) {",
					"            const jsonData = response.json();",
					"            pm.globals.set('adminToken', jsonData.access_token);",
					"            pm.globals.set('tokenExpiry', Date.now() + (55 * 60 * 1000)); // 55 mins",
					"            console.log('Admin token refreshed successfully');",
					"        } else {",
					"            console.log('Login failed with status:', response.code);",
					"        }",
					"    });",
					"}"
				],
				"type": "text/javascript"
			}
		}
	],
	"variable": [
		{
			"key": "resourcePermissionId",
			"value": "",
			"type": "string",
			"description": "ID of the created resource permission"
		},
		{
			"key": "roleId",
			"value": "",
			"type": "string",
			"description": "ID of the role dependency"
		},
		{
			"key": "testResource",
			"value": "test_resource",
			"type": "string",
			"description": "Test resource name for operations"
		},
		{
			"key": "testAction",
			"value": "read",
			"type": "string",
			"description": "Test action for operations"
		}
	],
