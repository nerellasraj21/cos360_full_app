{
	"info": {
		"_postman_id": "fee-class-mapping-crud-collection-uuid",
		"name": "Level 2: FeeClassMapping CRUD Operations",
		"description": "Comprehensive CRUD operations for FeeClassMapping model with dependencies on multiple entities.\n\nDependencies:\n- FeeType (fee_type_id) - Level 2\n- Class (class_id) - Level 1\n- AcademicYear (academic_year_id) - Level 0\n\nEndpoints tested:\n1. POST /fee/class-mappings - Create FeeClassMapping\n2. GET /fee/class-mappings - List All FeeClassMappings (with filters)\n3. GET /fee/class-mappings/{id} - Get FeeClassMapping by ID\n4. PUT /fee/class-mappings/{id} - Update FeeClassMapping\n5. DELETE /fee/class-mappings/{id} - Delete FeeClassMapping\n6. POST /fee/class-mappings/bulk - Bulk Create FeeClassMappings",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{adminToken}}",
				"type": "string"
			}
		]
	},
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"exec": [
					"// Auto-refresh admin token if needed",
					"if (!pm.globals.get('adminToken') || !pm.globals.get('tokenExpiry') || ",
					"    Date.now() > parseInt(pm.globals.get('tokenExpiry'))) {",
					"    ",
					"    const loginRequest = {",
					"        url: pm.environment.get('baseUrl') + '/auth/tenant-login',",
					"        method: 'POST',",
					"        header: {",
					"            'Content-Type': 'application/json',",
					"            'X-Client-Name': pm.environment.get('tenantName')",
					"        },",
					"        body: {",
					"            mode: 'raw',",
					"            raw: JSON.stringify({",
					"                username: pm.environment.get('adminUsername'),",
					"                password: pm.environment.get('adminPassword')",
					"            })",
					"        }",
					"    };",
					"    ",
					"    pm.sendRequest(loginRequest, function(err, response) {",
					"        if (err) {",
					"            console.log('Login request failed:', err);",
					"        } else if (response.code === 200) {",
					"            const jsonData = response.json();",
					"            pm.globals.set('adminToken', jsonData.access_token);",
					"            pm.globals.set('tokenExpiry', Date.now() + (55 * 60 * 1000)); // 55 mins",
					"            console.log('Admin token refreshed successfully');",
					"        } else {",
					"            console.log('Login failed with status:', response.code);",
					"        }",
					"    });",
					"}"
				],
				"type": "text/javascript"
			}
		}
	],
	"variable": [
		{
			"key": "feeClassMappingId",
			"value": "",
			"type": "string",
			"description": "ID of the created fee class mapping"
		},
		{
			"key": "feeTypeId",
			"value": "",
			"type": "string",
			"description": "ID of the fee type dependency"
		},
		{
			"key": "classId",
			"value": "",
			"type": "string",
			"description": "ID of the class dependency"
		},
		{
			"key": "academicYearId",
			"value": "",
			"type": "string",
			"description": "ID of the academic year dependency"
		}
	],
