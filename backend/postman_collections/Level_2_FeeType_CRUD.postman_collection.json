		{
			"name": "CREATE - Create FeeType",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code is 201', function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"",
							"pm.test('Response has required fee type fields', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('id');",
							"    pm.expect(jsonData).to.have.property('type_name');",
							"    pm.expect(jsonData).to.have.property('fee_category_id');",
							"    pm.expect(jsonData).to.have.property('fee_term_id');",
							"    pm.expect(jsonData).to.have.property('academic_year_id');",
							"    pm.expect(jsonData).to.have.property('fee_status');",
							"});",
							"",
							"pm.test('UUID format validation', function () {",
							"    const jsonData = pm.response.json();",
							"    const uuidRegex = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;",
							"    pm.expect(jsonData.id).to.match(uuidRegex);",
							"    pm.expect(jsonData.fee_category_id).to.match(uuidRegex);",
							"    pm.expect(jsonData.fee_term_id).to.match(uuidRegex);",
							"    pm.expect(jsonData.academic_year_id).to.match(uuidRegex);",
							"});",
							"",
							"pm.test('Created fee type has correct data', function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData.type_name).to.eql('Tuition Fee');",
							"    pm.expect(jsonData.fee_status).to.eql('active');",
							"    pm.expect(jsonData.fee_category_id).to.eql(pm.collectionVariables.get('feeCategoryId'));",
							"    pm.expect(jsonData.fee_term_id).to.eql(pm.collectionVariables.get('feeTermId'));",
							"    pm.expect(jsonData.academic_year_id).to.eql(pm.collectionVariables.get('academicYearId'));",
							"});",
							"",
							"pm.test('Response includes related entity names', function () {",
							"    const jsonData = pm.response.json();",
							"    // These might be null or populated depending on service implementation",
							"    pm.expect(jsonData).to.have.property('fee_category_name');",
							"    pm.expect(jsonData).to.have.property('fee_term_name');",
							"    pm.expect(jsonData).to.have.property('academic_year_name');",
							"});",
							"",
							"// Store fee type ID for subsequent requests",
							"if (pm.response.code === 201) {",
							"    const jsonData = pm.response.json();",
							"    pm.collectionVariables.set('feeTypeId', jsonData.id);",
							"    console.log('Created FeeType ID:', jsonData.id);",
							"}"
						],
						"type": "text/javascript"
					}
				}
