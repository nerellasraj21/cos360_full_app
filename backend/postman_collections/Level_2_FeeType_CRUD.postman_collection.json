{
	"info": {
		"_postman_id": "fee-type-crud-collection-uuid",
		"name": "Level 2: FeeType CRUD Operations",
		"description": "Comprehensive CRUD operations for FeeType model with dependencies on multiple entities.\n\nDependencies:\n- FeeCategory (fee_category_id) - Level 1\n- FeeTerm (fee_term_id) - Level 1\n- AcademicYear (academic_year_id) - Level 0\n\nEndpoints tested:\n1. POST /fee/types - Create FeeType\n2. GET /fee/types - List All FeeTypes\n3. GET /fee/types/{id} - Get FeeType by ID\n4. PUT /fee/types/{id} - Update FeeType\n5. DELETE /fee/types/{id} - Delete FeeType\n6. GET /fee/types/dropdown - FeeType Dropdown (with optional category filter)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{adminToken}}",
				"type": "string"
			}
		]
	},
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"exec": [
					"// Auto-refresh admin token if needed",
					"if (!pm.globals.get('adminToken') || !pm.globals.get('tokenExpiry') || ",
					"    Date.now() > parseInt(pm.globals.get('tokenExpiry'))) {",
					"    ",
					"    const loginRequest = {",
					"        url: pm.environment.get('baseUrl') + '/auth/tenant-login',",
					"        method: 'POST',",
					"        header: {",
					"            'Content-Type': 'application/json',",
					"            'X-Client-Name': pm.environment.get('tenantName')",
					"        },",
					"        body: {",
					"            mode: 'raw',",
					"            raw: JSON.stringify({",
					"                username: pm.environment.get('adminUsername'),",
					"                password: pm.environment.get('adminPassword')",
					"            })",
					"        }",
					"    };",
					"    ",
					"    pm.sendRequest(loginRequest, function(err, response) {",
					"        if (err) {",
					"            console.log('Login request failed:', err);",
					"        } else if (response.code === 200) {",
					"            const jsonData = response.json();",
					"            pm.globals.set('adminToken', jsonData.access_token);",
					"            pm.globals.set('tokenExpiry', Date.now() + (55 * 60 * 1000)); // 55 mins",
					"            console.log('Admin token refreshed successfully');",
					"        } else {",
					"            console.log('Login failed with status:', response.code);",
					"        }",
					"    });",
					"}"
				],
				"type": "text/javascript"
			}
		}
	],
	"variable": [
		{
			"key": "feeTypeId",
			"value": "",
			"type": "string",
			"description": "ID of the created fee type"
		},
		{
			"key": "feeCategoryId",
			"value": "",
			"type": "string",
			"description": "ID of the fee category dependency"
		},
		{
			"key": "feeTermId",
			"value": "",
			"type": "string",
			"description": "ID of the fee term dependency"
		},
		{
			"key": "academicYearId",
			"value": "",
			"type": "string",
			"description": "ID of the academic year dependency"
		}
	],
