# =============================================================================
# APPLICATION SETTINGS - PRODUCTION
# =============================================================================
# Production environment settings
DEBUG=true
ENVIRONMENT=production

# JWT Settings
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Application Settings
PAGE_SIZE=20
LOG_LEVEL=WARNING

TENANT_ALLOW_DEFAULT_FALLBACK="true"
TENANT_DEFAULT_NAME="little bunny"
TENANT_STRICT_MODE="false"

# =============================================================================
# DATABASE MIGRATION SETTINGS - PRODUCTION
# =============================================================================
# Production schema name (set via environment variable, not in Settings class)
SCHEMA_NAME=cos360_master

