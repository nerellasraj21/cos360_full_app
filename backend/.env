# COS360 Production Environment Variables Template
# DO NOT commit this file to version control
# Update these values with your actual production settings

# =============================================================================
# DATABASE CONFIGURATION - PRODUCTION
# =============================================================================
# Replace with your actual production database server
#DATABASE_URL=postgresql+asyncpg://cos360_user:SECURE_PASSWORD_HERE@your-production-db-server:5432/cos360_production
#DATABASE_URL=postgresql+asyncpg://neondb_owner:npg_3BRCMxJ8aKdN@ep-old-salad-a1x7ae1e-pooler.ap-southeast-1.aws.neon.tech/neondb?ssl=require
DATABASE_URL=postgresql+asyncpg://postgres:Passw0rd!@localhost/postgres
# =============================================================================
# REDIS CONFIGURATION - PRODUCTION  
# =============================================================================
# Replace with your actual production Redis server
REDIS_URL=redis://your-production-redis-server:6379
# For Redis with password: redis://:password@your-redis-server:6379

# =============================================================================
# SECURITY KEYS - PRODUCTION (GENERATE SECURE VALUES)
# =============================================================================
# Generate secure random 64+ character strings for production
SECRET_KEY=GENERATE-A-SECURE-64-CHARACTER-RANDOM-STRING-HERE-FOR-PRODUCTION-USE
JWT_SECRET_KEY=GENERATE-ANOTHER-SECURE-64-CHARACTER-RANDOM-STRING-FOR-JWT-TOKENS

# =============================================================================
# APPLICATION SETTINGS - PRODUCTION
# =============================================================================
# Production environment settings
DEBUG=false
ENVIRONMENT=production

# JWT Settings
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Application Settings
PAGE_SIZE=20
LOG_LEVEL=WARNING

# =============================================================================
# DATABASE MIGRATION SETTINGS - PRODUCTION
# =============================================================================
# Production schema name (set via environment variable, not in Settings class)
# SCHEMA_NAME=test_tenant_schema

# =============================================================================
# HOSTING PLATFORM SPECIFIC SETTINGS
# =============================================================================
# Uncomment and configure based on your hosting platform

# For Railway/Render/Heroku style deployments:
# PORT=8000
# HOST=0.0.0.0

# For AWS/Google Cloud/Azure:
# Add any additional environment variables required by your cloud provider

# =============================================================================
# SECURITY CHECKLIST FOR PRODUCTION
# =============================================================================
# ✓ Updated DATABASE_URL with production database server
# ✓ Updated REDIS_URL with production Redis server  
# ✓ Generated secure SECRET_KEY (64+ chars)
# ✓ Generated secure JWT_SECRET_KEY (64+ chars)
# ✓ Set DEBUG=false
# ✓ Set ENVIRONMENT=production
# ✓ Set appropriate LOG_LEVEL (WARNING or ERROR)
